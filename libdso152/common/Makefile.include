# FNIRSI DSO-152 Open SDK Common Makefile Include
# Include this file in your application Makefile:
#   TARGET = my_app
#   SRCS = main.c ...
#   include ../../libdso152/common/Makefile.include

# 1. Toolchain configuration
DEFAULT_TOOLCHAIN := /home/joao/projects/TCC-2/SDK/Lyra-sdk/prebuilts/gcc/linux-x86/arm/gcc-arm-none-eabi-10-2020-q4-major-x86_64-linux/bin/arm-none-eabi-
CROSS_COMPILE ?= $(if $(wildcard $(DEFAULT_TOOLCHAIN)gcc),$(DEFAULT_TOOLCHAIN),arm-none-eabi-)

CC      = $(CROSS_COMPILE)gcc
CXX     = $(CROSS_COMPILE)g++
AR      = $(CROSS_COMPILE)ar
OBJCOPY = $(CROSS_COMPILE)objcopy
OBJDUMP = $(CROSS_COMPILE)objdump
SIZE    = $(CROSS_COMPILE)size

# 2. SDK Root Resolution
SDK_DIR ?= $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/..)

# 3. Target MCU Architecture & Compilation Flags
MCU_FLAGS = -mcpu=cortex-m3 -mthumb -mfloat-abi=soft

CFLAGS += $(MCU_FLAGS)
CFLAGS += -O2 -g -Wall -Wextra -ffunction-sections -fdata-sections
CFLAGS += -I$(SDK_DIR)/include -I$(SDK_DIR)/common $(EXTRA_INCLUDES)

LDSCRIPT = $(SDK_DIR)/common/dso152_app.ld
LDFLAGS += $(MCU_FLAGS)
LDFLAGS += -nostartfiles -T$(LDSCRIPT)
LDFLAGS += -Wl,--gc-sections -Wl,-Map=$(BUILD_DIR)/$(TARGET).map

BUILD_DIR ?= build

# Sources: application sources + startup file
APP_SRCS ?= $(SRCS)
ALL_C_SRCS = $(APP_SRCS) $(SDK_DIR)/common/startup.c
OBJS = $(patsubst %.c,$(BUILD_DIR)/%.o,$(notdir $(ALL_C_SRCS)))

# VPATH for resolving source locations
VPATH = $(dir $(APP_SRCS)) $(SDK_DIR)/common

# SDK Library
SDK_LIB = $(SDK_DIR)/libdso152.a

all: $(BUILD_DIR)/$(TARGET).bin $(BUILD_DIR)/$(TARGET).hex
	@echo "--------------------------------------------------------"
	@echo "Build complete: $(BUILD_DIR)/$(TARGET).bin"
	@echo "Ready to copy to 'DSO BOOT' USB drive!"
	@echo "--------------------------------------------------------"

$(SDK_LIB):
	@$(MAKE) -C $(SDK_DIR)

$(BUILD_DIR):
	@mkdir -p $(BUILD_DIR)

$(BUILD_DIR)/%.o: %.c | $(BUILD_DIR)
	@echo "  CC $<"
	@$(CC) $(CFLAGS) -c $< -o $@

$(BUILD_DIR)/$(TARGET).elf: $(OBJS) $(SDK_LIB) $(LDSCRIPT)
	@echo "  LD $@"
	@$(CC) $(OBJS) -L$(SDK_DIR) -ldso152 $(LDFLAGS) -o $@
	@$(SIZE) $@

$(BUILD_DIR)/$(TARGET).bin: $(BUILD_DIR)/$(TARGET).elf
	@echo "  OBJCOPY $@"
	@$(OBJCOPY) -O binary $< $@

$(BUILD_DIR)/$(TARGET).hex: $(BUILD_DIR)/$(TARGET).elf
	@echo "  OBJCOPY $@"
	@$(OBJCOPY) -O ihex $< $@

clean:
	rm -rf $(BUILD_DIR)

.PHONY: all clean
